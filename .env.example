# Local development database. The Compose service exposes MariaDB on 127.0.0.1:3307.
KM_DB_HOST=127.0.0.1
KM_DB_PORT=3307
KM_DB_USER=hcm_km
KM_DB_PASSWORD=hcm_km_dev
KM_DB_NAME=hcm_km_dev

# Test scripts create and drop only databases with these prefixes.
KM_TEST_DB_HOST=127.0.0.1
KM_TEST_DB_PORT=3307
KM_TEST_DB_USER=root
KM_TEST_DB_PASSWORD=hcm_km_root
KM_TEST_DB_NAME=hcm_km_test_local
KM_TEST_DB_PREFIX=hcm_km_test_
KM_E2E_DB_PREFIX=hcm_km_e2e_

# The local identity is server configuration, never a form or request value.
KM_LOCAL_IDENTITY_ENABLED=true
KM_LOCAL_ID=0199f000-0000-7000-8000-000000000001
KM_LOCAL_EMP_ID=LOCAL-0001
KM_LOCAL_NAME=Local Knowledge User
KM_LOCAL_ORG_CODE=LOCAL

# Team workspaces are announced and not yet open: the workspace switcher shows "Coming soon" and takes
# nobody to one. Set to true to open them. Read on every request, so it takes a restart, not a build.
# Trusted requests are also limited to My Space while this is false.
KM_TEAM_WORKSPACES_ENABLED=false

# Test-only E2E opt-in: permits the Local identity provider under
# NODE_ENV=production so the E2E harness can boot `next start`.
# NEVER set this in a real company production deployment — production
# readiness still requires KM_IDENTITY_PROVIDER=company-sso.
# KM_ALLOW_LOCAL_IDENTITY_IN_PRODUCTION=true

# Phase 2 folder import resource limits. Retention is fixed by the Phase 2 contract:
# BUILDING 2h, READY 30m, STALE/APPLIED 24h.
KM_IMPORT_MAX_MANIFEST_ENTRIES=20000
KM_IMPORT_MAX_PATH_BYTES=2048
KM_IMPORT_MAX_MARKDOWN_FILE_BYTES=5242880
KM_IMPORT_MAX_MARKDOWN_TOTAL_BYTES=268435456
KM_IMPORT_MAX_ASSET_FILE_BYTES=67108864
KM_IMPORT_MAX_ASSET_TOTAL_BYTES=536870912
KM_IMPORT_MAX_METADATA_BYTES=262144
KM_IMPORT_MAX_UPLOAD_BATCH_FILES=20
KM_IMPORT_MAX_UPLOAD_BATCH_BYTES=10485760
KM_IMPORT_MAX_BUILDING_PER_USER=3
KM_IMPORT_MAX_READY_PER_USER=10

# Where synced folders' images are stored. Neither set: images stay reference-only.
# Choose ONE of the two; the server refuses to start with both (README, "Images").
#
# A) An S3-compatible bucket (MinIO), addressed path-style: <endpoint>/<bucket>/<prefix>sha256/...
#    These values are the local MinIO from compose.yaml, which `make dev` starts (`make storage-up`),
#    so development stores images the way production does.
#    Company MinIO: the same four settings with your endpoint, bucket and a key pair that may
#    read, write, delete and list in that bucket. The bucket must already exist.
KM_BLOB_S3_ENDPOINT=http://127.0.0.1:9000
KM_BLOB_S3_BUCKET=knowledge-hub-dev
KM_BLOB_S3_ACCESS_KEY=hcm_km_minio
KM_BLOB_S3_SECRET_KEY=hcm_km_minio_dev
#    Optional: a folder inside the bucket (e.g. knowledge-hub). One prefix serves one database: never share it between deployments.
# KM_BLOB_S3_PREFIX=
#    Optional: the signing region. MinIO accepts the default.
# KM_BLOB_S3_REGION=us-east-1
#
# B) A directory, for a single server without object storage: the mount path of a persistent
#    volume, e.g. a Kubernetes PVC. Must already exist and be writable. Remove the four lines above first.
# KM_BLOB_DIR=/var/lib/knowledge-hub/blobs

KM_E2E_PORT=3101
